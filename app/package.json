{
  "name": "supergrid-desktop",
  "productName": "SuperGrid",
  "version": "0.1.0",
  "description": "The SuperGrid manager: organizations, workspaces, apps and the coding agent, on your machine.",
  "author": "SuperGrid",
  "homepage": "https://supergrid.com",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "package": "electron-vite build && electron-builder --mac --dir",
    "dist": "electron-vite build && electron-builder --mac dmg",
    "dist:adhoc": "electron-vite build && electron-builder --mac dmg -c.mac.identity=- -c.mac.notarize=false",
    "icons": "electron scripts/icons.mjs && node scripts/brand-electron.mjs",
    "brand": "node scripts/brand-electron.mjs",
    "postinstall": "node scripts/brand-electron.mjs"
  },
  "dependencies": {
    "pnpm": "9.15.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@streamdown/code": "^2.0.0",
    "@supergrid/admin-sdk": "link:../core/packages/admin-sdk",
    "@supergrid/app-kit": "link:../core/packages/app-kit",
    "@supergrid/cloud": "link:../core/packages/cloud",
    "@supergrid/theme": "link:../core/packages/theme",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.25",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ai": "^7",
    "cal-sans": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-beautiful-color": "2.1.0",
    "react-dom": "^19.3.1",
    "react-querybuilder": "8.26.0",
    "react-router": "^8.5.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "build": {
    "appId": "dev.supergrid.desktop",
    "productName": "SuperGrid",
    "copyright": "© 2026 SuperGrid",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "asarUnpack": [
      "node_modules/pnpm/**"
    ],
    "extraResources": [
      {
        "from": "../core",
        "to": "core",
        "filter": [
          "tsconfig.base.json",
          "templates/**",
          "packages/{admin-sdk,admin-ui,app-kit,theme,ui}/**",
          "workspace/**",
          "!**/node_modules/**",
          "!**/{dist,build,.wrangler,.state,.react-router}/**",
          "!**/.DS_Store"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "SuperGrid ${version}",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    }
  }
}
