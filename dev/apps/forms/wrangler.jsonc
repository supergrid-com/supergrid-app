{
  // Local dev config. Real installs get a generated config from sg (deploy/apps/<ws>-forms/wrangler.jsonc).
  "name": "app-forms",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [{ "binding": "WORKSPACE", "service": "ws-local", "entrypoint": "WorkspaceApi" }],
  "d1_databases": [{ "binding": "DB", "database_name": "ws-local", "database_id": "11111111-1111-1111-1111-111111111111" }],
  "observability": { "enabled": true }
}
