{
  // Local dev only. Real workspaces are one signed bundle deployed many times, with bindings set by the platform.
  "name": "ws-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "ws-local", "database_id": "11111111-1111-1111-1111-111111111111" }],
  // Events ride a queue when there is one; the Worker writes straight to D1 without it (see src/events.ts).
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "ws-local-events" }],
    "consumers": [
      { "queue": "ws-local-events", "max_batch_size": 50, "max_batch_timeout": 2, "max_retries": 5, "dead_letter_queue": "ws-local-events-dlq" },
      { "queue": "ws-local-events-dlq", "max_retries": 1 }
    ]
  },
  "workflows": [{ "binding": "HOOK_RUN", "name": "ws-local-hooks", "class_name": "HookRun" }],
  // Files and, without a media token, pictures (see src/assets.ts). Local runs keep the bucket on disk under .state.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ws-local-files" }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "WORKSPACE_ID": "local",
    "WORKSPACE_NAME": "Local workspace",
    "WORKSPACE_URL": "http://localhost:5301",
    "SG_VERSION": "dev",
    "SG_WORKSPACE_TOKEN": "dev-token",
    // Seals the secrets table. Any string works locally; real workspaces get 32 random bytes from the desktop.
    "SG_SECRETS_KEY": "dev-secrets-key",
    // Apps add themselves here in dev (see @supergrid/app-kit/vite); real workspaces get this from the platform.
    "ROUTES": []
    // Images and Stream need CF_ACCOUNT_ID and SG_MEDIA_TOKEN in .dev.vars (see .dev.vars.example); without them pictures and video go to the bucket as plain files.
  },
  "observability": { "enabled": true }
}
